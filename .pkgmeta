# BigWigsMods packager config: https://github.com/BigWigsMods/packager/wiki
package-as: Dyreparken

# Libraries are committed in Libs/, so no externals and no -nolib zip.
enable-nolib-creation: no

# Development files that don't belong in the zip players install.
ignore:
  - tools
  - docs
  - CLAUDE.md
  - README.md
  - .claude
  - .luarc.json
  - .github
  - .githooks

# The changelog is written by the release workflow (.github/workflows/release.yml):
# commit subjects only, with the Claude credit once at the top.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
